{
  "name": "shoppable-video-analytics-dashboard",
  "private": true,
  "workspaces": ["backend", "client"],
  "scripts": {
    "install:all": "npm install",
    "db:migrate": "npm --workspace backend run migrate",
    "db:seed": "npm --workspace backend run seed",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:client\"",
    "dev:backend": "npm --workspace backend run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "test": "npm --workspace backend test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
